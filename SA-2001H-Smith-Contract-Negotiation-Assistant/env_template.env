# =========================================================================
# SMITH-ATLAS CONTRACT NEGOTIATION ASSISTANT (SA-2001H-V1)
# SERVER CONFIGURATION
# Copyright 2026 Smith-Atlas LLC. MIT License.
# =========================================================================
#
# ALL configuration lives in this file and is managed by IT. The task pane has
# no setup screen: the end user only chooses a Playbook, an Engine (Cloud or
# Local), and a Review Depth. Any change here takes effect only after the Node
# server is restarted (Ctrl+C, then `node server.js`).
#
# --- Node Server Location ---
NODE_SERVER_URL=http://localhost:3001

# --- Contract Playbooks (shared, read-only) ---
LOCAL_PLAYBOOKS_PATH=<YOUR_ABSOLUTE_LOCAL_PLAYBOOKS_FOLDER_PATH>

# --- Default Engine -------------------------------------------------------
# Which engine the task pane selects by default: "cloud" or "local".
# The user can still switch to the other engine per review IF it is configured
# below. If the chosen default is not configured, the task pane falls back to
# whichever engine IS configured.
DEFAULT_PROVIDER=cloud

# --- Local LLM Engine (Ollama / vLLM) -------------------------------------
# Configure these to enable the "Local Secure Engine (Ollama)" option. Leave
# the URL/model as-is (localhost defaults) only for on-box testing; for a real
# deployment set LOCAL_AI_SERVER_URL to the on-prem/RunPod endpoint.
LOCAL_AI_SERVER_URL=http://localhost:11434
LOCAL_DEFAULT_MODEL=llama4:maverick

# --- Cloud LLM Engine -----------------------------------------------------
# The cloud engine supports five vendor strategies, selected by CLOUD_API_STRATEGY.
# Fill in ONLY the variables for the strategy you choose. The primary and fallback
# models are fixed here; the user does not choose a model in the pane.
#
# CLOUD_API_STRATEGY options:
#   gemini-native      Google AI Studio (simple API key)        -> needs CLOUD_API_KEY
#   openai-compatible  OpenAI / Azure OpenAI / xAI (Grok)       -> needs CLOUD_API_KEY + CLOUD_BASE_ENDPOINT
#   anthropic-native   Anthropic Claude (api.anthropic.com)     -> needs CLOUD_API_KEY + CLOUD_BASE_ENDPOINT
#   gemini-vertex      Google Vertex AI / Gemini Enterprise     -> needs VERTEX_* + GOOGLE_APPLICATION_CREDENTIALS
#   bedrock            Amazon Bedrock (Claude on AWS)           -> needs AWS_* credentials
#
CLOUD_API_STRATEGY=gemini-native

# Shared by the single-API-key strategies (gemini-native, openai-compatible, anthropic-native).
# For anthropic-native set CLOUD_BASE_ENDPOINT=https://api.anthropic.com
# For openai-compatible set it to the vendor's base URL (e.g. https://api.openai.com).
CLOUD_BASE_ENDPOINT=https://generativelanguage.googleapis.com
CLOUD_API_KEY=<YOUR_API_KEY>
CLOUD_MODEL_PRIMARY=gemini-3.1-pro-preview
CLOUD_MODEL_FALLBACK=gemini-2.5-pro

# --- Vertex AI (only for CLOUD_API_STRATEGY=gemini-vertex) -----------------
# Vertex authenticates with a Google Cloud service account, NOT an API key. Create a
# service account with the Vertex AI User role, download its JSON key, and point
# GOOGLE_APPLICATION_CREDENTIALS at that file. CLOUD_MODEL_PRIMARY/FALLBACK hold the
# Vertex Gemini model IDs. CLOUD_API_KEY is not used by this strategy.
VERTEX_PROJECT_ID=<YOUR_GCP_PROJECT_ID>
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=<ABSOLUTE_PATH_TO_SERVICE_ACCOUNT_JSON>

# --- Amazon Bedrock (only for CLOUD_API_STRATEGY=bedrock) ------------------
# Bedrock authenticates with AWS credentials (SigV4). Create an IAM user/role with
# bedrock:InvokeModel permission and enable model access for your chosen Claude model
# in your region. CLOUD_MODEL_PRIMARY/FALLBACK hold the Bedrock model IDs
# (e.g. anthropic.claude-...-v1:0). CLOUD_API_KEY is not used by this strategy.
AWS_REGION=<YOUR_AWS_REGION>
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>

# --- Diagnostics ----------------------------------------------------------
# Verbose per-run diagnostic logging in the server console. Default false, which
# keeps a clean install quiet during normal operation. Set to true ONLY to debug a
# problem: it surfaces detailed per-run traces ([DIAG-*] and [DIAGNOSTIC] dumps) so
# you can inspect what the model returned and how each pass behaved. Set it back to
# false (or remove it) when finished. Genuine errors are always shown regardless of
# this setting, and the value takes effect only after the server is restarted.
DIAG_VERBOSE=false

# --- License & Audit ---
ENTERPRISE_LICENSE_KEY=<YOUR_ENTERPRISE_LICENSE_KEY>
AUDIT_LOG_SALT=<ROTATE_THIS_AT_PROVISIONING>
